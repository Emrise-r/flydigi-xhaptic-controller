{
  "hotkeys": {
    "toggle": "Ctrl+Alt+R",
    "switchSource": "Ctrl+Alt+P",
    "rearmOnce": ""
  },
  "engine": {
    "apiUrl": "http://127.0.0.1:18757",
    "webOrigin": "https://space_station.flydigi.com",
    "statusSocketPort": 18758,
    "exePath": "C:\\Program Files\\Flydigi\\Engine\\xHaptics Engine.exe",
